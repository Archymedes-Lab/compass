{
  "name": "compass",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/server.ts",
    "start": "NODE_ENV=production bun src/server.ts",
    "seed": "bun src/seed.ts",
    "sync": "bun scripts/compass-sync.ts",
    "test": "bun test tests",
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && bun build web/index.html --outdir dist --minify && cp web/_headers dist/",
    "deploy": "bun run build && wrangler deploy --var BUILD:$(date +%s)"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261109.1",
    "@types/bun": "^1.4.4",
    "@types/react": "18",
    "@types/react-dom": "18",
    "typescript": "^7.0.2",
    "wrangler": "^4.158.0"
  }
}
